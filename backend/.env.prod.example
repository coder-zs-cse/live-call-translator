# Copy to .env.prod and fill in. Never commit .env.prod.
# Selected by APP_ENV=prod. Loading this is always a deliberate act.
APP_ENV=prod
LOG_LEVEL=INFO

# --- Sarvam AI -------------------------------------------------------------
SARVAM__API_KEY=sk-replace-me
SARVAM__TRANSLATE_MODEL=mayura:v1
SARVAM__STT_MODEL=saaras:v3-realtime
SARVAM__TTS_MODEL=bulbul:v3

# --- Vobiz telephony -------------------------------------------------------
VOBIZ__AUTH_ID=replace-me
VOBIZ__AUTH_TOKEN=replace-me
VOBIZ__PHONE_NUMBER=+911234567890
VOBIZ__PUBLIC_BASE_URL=https://api.yourdomain.com

# --- Infrastructure --------------------------------------------------------
DATABASE__URL=postgresql+asyncpg://USER:PASS@HOST:5432/lct
REDIS__URL=rediss://HOST:6379/0

# --- Admin -----------------------------------------------------------------
ADMIN__BYPASS_TOKEN=generate-a-long-random-value

# --- Pipeline (test-call behaviour, removed in Phase 4) --------------------
# echo | translate_loopback
PIPELINE__MODE=translate_loopback
PIPELINE__LOOPBACK_SOURCE_LANGUAGE=hi-IN
PIPELINE__LOOPBACK_TARGET_LANGUAGE=ta-IN
PIPELINE__VAD_STOP_SECONDS=0.7
