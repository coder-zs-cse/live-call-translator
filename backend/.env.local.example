# Copy to .env.local and fill in. Never commit .env.local.
# Selected by APP_ENV=local (the default).
APP_ENV=local
LOG_LEVEL=DEBUG

# --- Sarvam AI -------------------------------------------------------------
SARVAM__API_KEY=sk-replace-me
SARVAM__TRANSLATE_MODEL=mayura:v1
SARVAM__STT_MODEL=saaras:v3-realtime
SARVAM__TTS_MODEL=bulbul:v3

# --- Vobiz telephony -------------------------------------------------------
VOBIZ__AUTH_ID=replace-me
VOBIZ__AUTH_TOKEN=replace-me
VOBIZ__PHONE_NUMBER=+911234567890
# Public base URL Vobiz calls back on. Use an ngrok/cloudflared tunnel locally:
#   cloudflared tunnel --url http://localhost:8000
VOBIZ__PUBLIC_BASE_URL=https://shuffling-august-geriatric.ngrok-free.dev/localvoice

# --- Infrastructure --------------------------------------------------------
DATABASE__URL=postgresql+asyncpg://lct:lct@localhost:5432/lct
REDIS__URL=redis://localhost:6379/0

# --- Admin -----------------------------------------------------------------
ADMIN__BYPASS_TOKEN=local-dev-token

# --- Pipeline (test-call behaviour, removed in Phase 4) --------------------
# echo | translate_loopback
PIPELINE__MODE=translate_loopback
PIPELINE__LOOPBACK_SOURCE_LANGUAGE=hi-IN
PIPELINE__LOOPBACK_TARGET_LANGUAGE=ta-IN
PIPELINE__VAD_STOP_SECONDS=0.7
